---
import Mock from '../../layouts/Mock.astro';
import Banner from '../../components/Banner.astro';
import Repl from '../../components/Repl.astro';
import { profile } from '../../content/resume';
---

<Mock title="B — Pure REPL" variant="b">
  <main class="wrap">
    <Banner />

    <p class="comment boot">
      gravlax tty1 · {profile.title} · {profile.location}<br />
      Last login: just now on ttys000
    </p>

    <hr class="rule" />

    <Repl mode="full" greeting />
  </main>
</Mock>

<style>
  .boot {
    margin-bottom: 0;
  }

  .wrap {
    min-height: 100vh;
    padding-bottom: var(--sp-8);
  }
</style>

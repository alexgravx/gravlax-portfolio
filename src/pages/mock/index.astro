---
import Mock from '../../layouts/Mock.astro';

const options = [
  {
    id: 'a',
    name: 'Hybrid — scroll + live prompt',
    body:
      'A scrollable page dressed as a terminal session, plus a real command prompt docked at the ' +
      'bottom. Recruiters scroll and get everything; hackers type and get delighted.',
  },
  {
    id: 'b',
    name: 'Pure REPL',
    body:
      'The site IS a terminal. Nothing renders until you type. Maximum hacker cred, real bounce ' +
      'risk for anyone who will not play along.',
  },
  {
    id: 'c',
    name: 'Scroll-only',
    body:
      'A jacquin.xyz-style static terminal document. Simplest and safest, but no interactive ' +
      'wow-factor.',
  },
];
---

<Mock title="Pick a direction" variant="a">
  <main class="wrap">
    <h1 class="title">Pick a direction</h1>
    <p class="comment">
      # Two decisions. Open each nav model, then cycle the palette with keys
      <strong>1</strong> / <strong>2</strong> / <strong>3</strong> (or the chips above).
      <br />
      # The palette follows you across all three pages.
    </p>

    <hr class="rule" />

    <ul class="opts">
      {
        options.map((o) => (
          <li>
            <a class="opt" href={`/mock/${o.id}`}>
              <span class="opt-name">
                {o.id.toUpperCase()} — {o.name}
              </span>
              <span class="opt-body">{o.body}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <hr class="rule" />

    <p class="comment">
      # Palettes: <strong>1</strong> retro beige (the simon.lecoq.io look) ·
      <strong>2</strong> near-black + green accent · <strong>3</strong> phosphor CRT
    </p>
    <p class="comment"># Also worth a look: <a href="/resume">/resume</a> — printable to one page.</p>
  </main>
</Mock>

<style>
  .title {
    font-size: var(--step-2);
    margin-bottom: var(--sp-3);
  }

  .opts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .opt {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-4);
    border: 1px solid var(--border);
    color: var(--ink);
  }

  .opt:hover {
    border-color: var(--accent);
    background: var(--surface);
  }

  .opt-name {
    color: var(--accent);
    font-weight: 700;
  }

  .opt-body {
    color: var(--dim);
    max-width: var(--measure);
  }
</style>

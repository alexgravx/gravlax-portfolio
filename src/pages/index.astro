---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Projects from '../components/Projects.astro';
import SkillsTree from '../components/SkillsTree.astro';
import Contact from '../components/Contact.astro';
import SectionHead from '../components/SectionHead.astro';
import { profile, education, experience, sections } from '../content/resume';

/** Section headers live in the data file, so the shell commands shown are editable there. */
const head = (id: string) => sections.find((s) => s.id === id)!.cmd;
---

<Base>
  {/* First screen: the terminal, and nothing else. */}
  <section id="home" class="screen">
    <Terminal />
    <a class="scroll-cue" href="#about" aria-label="Scroll down">
      <span aria-hidden="true">▾</span>
    </a>
  </section>

  <main class="wrap">
    <section id="about">
      <SectionHead cmd={head('about')} label="about" />
      <p class="bio">{profile.bio}</p>
    </section>

    <hr class="rule" />

    <section id="projects" class="bleed">
      <SectionHead cmd={head('projects')} label="projects" />
      <Projects />
    </section>

    <hr class="rule" />

    <section id="experience">
      <SectionHead cmd={head('experience')} label="experience" />
      {
        experience.map((r) => (
          <div class="entry">
            <div class="entry-head">
              <strong>
                {r.href ? (
                  <a href={r.href} target="_blank" rel="noopener noreferrer">
                    {r.org}
                  </a>
                ) : (
                  r.org
                )}
                <span class="comment"> · {r.title}</span>
              </strong>
              <span class="comment">
                {r.start} — {r.end}
              </span>
            </div>
            <p>{r.summary}</p>
            <ul class="tags">
              {r.stack.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <hr class="rule" />

    <section id="skills">
      <SectionHead cmd={head('skills')} label="skills" />
      <SkillsTree />
    </section>

    <hr class="rule" />

    <section id="education">
      <SectionHead cmd={head('education')} label="education" />
      {
        education.map((e) => (
          <div class="entry">
            <div class="entry-head">
              <strong>{e.school}</strong>
              <span class="comment">{e.date}</span>
            </div>
            <div>
              {e.degree}
              {e.note && <span class="comment"> ({e.note})</span>}
            </div>
            <p class="comment">{e.summary}</p>
          </div>
        ))
      }
    </section>

    <hr class="rule" />

    <section id="contact">
      <SectionHead cmd={head('contact')} label="contact" />
      <Contact />
    </section>

    <hr class="rule" />

    <p class="comment sign"># {profile.name} — built with Astro. No trackers, no cookies.</p>
  </main>
</Base>

<style>
  /* The terminal owns the first screen. Nothing else is above the fold. */
  .screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    min-height: 100svh;
    padding: var(--sp-5) var(--sp-4) var(--sp-6);
  }

  .screen :global(.term) {
    width: min(96ch, 100%);
    height: min(30rem, 70svh);
  }

  .scroll-cue {
    color: var(--faint);
    border: 0;
    font-size: var(--step-1);
    line-height: 1;
    animation: nudge 1.8s ease-in-out infinite;
  }

  .scroll-cue:hover {
    color: var(--accent);
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  section[id] {
    scroll-margin-top: var(--sp-5);
  }

  .bio {
    font-size: var(--step-1);
    line-height: 1.7;
  }

  .entry p {
    margin: var(--sp-2) 0 0;
  }

  .sign {
    margin: 0;
  }
</style>

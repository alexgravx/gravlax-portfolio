---
import * as simpleIcons from 'simple-icons';
import { skills } from '../content/resume';

/**
 * `tree skills/` — real branch glyphs, each leaf carrying its brand logo.
 * Groups are collapsible <details>, so the section stays compact.
 *
 * simple-icons is a devDependency: paths are inlined at build time, so the page
 * makes no external requests and ships no icon runtime.
 */

type Icon = { path: string; hex: string };

function icon(slug: string): Icon | null {
  const key = 'si' + slug.charAt(0).toUpperCase() + slug.slice(1);
  return (simpleIcons as unknown as Record<string, Icon>)[key] ?? null;
}

/** Perceived luminance, 0–1. */
function luminance(hex: string): number {
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
  return 0.2126 * r! + 0.7152 * g! + 0.0722 * b!;
}

/** Next.js (#000), Express (#0A0A0A) and Pandas (#150458) would vanish on the
    dark background. Lift those toward white so the hover colour is always seen. */
function forDark(hex: string): string {
  const l = luminance(hex);
  if (l >= 0.3) return `#${hex}`;
  const mix = Math.round((0.55 - l) * 160);
  const lifted = [0, 2, 4]
    .map((i) => Math.min(255, parseInt(hex.slice(i, i + 2), 16) + mix))
    .map((v) => v.toString(16).padStart(2, '0'))
    .join('');
  return `#${lifted}`;
}

const groups = Object.entries(skills);
---

<div class="tree">
  <div class="root">skills/</div>

  {
    groups.map(([group, items], gi) => {
      const lastGroup = gi === groups.length - 1;
      return (
        <details class="group" open={gi === 0}>
          <summary class="branch">
            <span class="glyph">{lastGroup ? '└──' : '├──'}</span>
            <span class="caret" aria-hidden="true">
              ▸
            </span>
            <span class="dir">{group}/</span>
            <span class="count">{items.length}</span>
          </summary>

          <ul class="leaves">
            {items.map((skill, si) => {
              const ic = skill.icon ? icon(skill.icon) : null;
              const lastLeaf = si === items.length - 1;
              return (
                <li
                  class="leaf"
                  style={ic ? `--brand:#${ic.hex}; --brand-dark:${forDark(ic.hex)};` : undefined}
                >
                  <span class="glyph pipe">{lastGroup ? ' ' : '│'}</span>
                  <span class="glyph">{lastLeaf ? '└──' : '├──'}</span>
                  {ic ? (
                    <svg class="logo" viewBox="0 0 24 24" aria-hidden="true">
                      <path d={ic.path} />
                    </svg>
                  ) : (
                    <span class="logo-fallback" aria-hidden="true">
                      ■
                    </span>
                  )}
                  <span class="name">{skill.name}</span>
                </li>
              );
            })}
          </ul>
        </details>
      );
    })
  }
</div>

<style>
  .tree {
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .root {
    color: var(--accent);
    font-weight: 700;
  }

  .group {
    /* Collapsed by default for all but the first group; the caret rotates. */
  }

  .branch {
    display: flex;
    align-items: center;
    gap: 0.8ch;
    cursor: pointer;
    width: fit-content;
    padding-right: var(--sp-2);
    border-radius: 3px;
    list-style: none;
  }

  /* Kill the native disclosure triangle; we draw our own caret. */
  .branch::-webkit-details-marker {
    display: none;
  }

  .branch:hover {
    background: var(--surface);
  }

  .caret {
    /* inline-block, not inline: `transform` is ignored on non-replaced
       inline elements, so the caret would never rotate. */
    display: inline-block;
    color: var(--accent);
    font-size: 0.8em;
    transition: transform 0.18s ease-out;
  }

  .group[open] > .branch .caret {
    transform: rotate(90deg);
  }

  .glyph {
    color: var(--faint);
    white-space: pre;
    user-select: none;
  }

  .dir {
    color: var(--ink);
    font-weight: 700;
  }

  .count {
    color: var(--faint);
    font-size: var(--step--2);
  }

  .count::before {
    content: '(';
  }

  .count::after {
    content: ')';
  }

  .leaves {
    list-style: none;
    margin: 0;
    padding: 0;
    animation: open 0.2s ease-out;
  }

  .leaf {
    display: flex;
    align-items: center;
    gap: 0.8ch;
    width: fit-content;
    padding-right: var(--sp-2);
    border-radius: 3px;
    transition: background 0.15s ease;
  }

  .pipe {
    padding-right: 1.2ch;
  }

  .logo {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    fill: var(--dim);
    transition: fill 0.2s ease, transform 0.2s ease;
  }

  .logo-fallback {
    width: 14px;
    text-align: center;
    color: var(--faint);
    flex-shrink: 0;
  }

  .name {
    color: var(--dim);
    transition: color 0.2s ease;
  }

  .leaf:hover {
    background: var(--surface);
  }

  .leaf:hover .logo {
    fill: var(--brand, var(--accent));
    transform: scale(1.15);
  }

  .leaf:hover .name {
    color: var(--ink);
  }

  :global(html[data-theme='dark']) .leaf:hover .logo {
    fill: var(--brand-dark, var(--accent));
  }

  @keyframes open {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
  }
</style>

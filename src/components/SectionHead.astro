---
/** Section header, rendered as a shell command line: `$ cat experience.md`. */
interface Props {
  cmd: string;
  label: string;
}

const { cmd, label } = Astro.props;
---

<h2 class="head">
  <span class="sigil">$</span>
  <span class="cmd" data-scramble>{cmd}</span>
  <span class="sr-only">— {label}</span>
</h2>

<style>
  .head {
    display: flex;
    align-items: baseline;
    gap: 0.8ch;
    font-size: var(--step-0);
    margin-bottom: var(--sp-5);
  }

  .sigil {
    color: var(--accent);
    font-weight: 700;
  }

  .cmd {
    font-weight: 700;
  }
</style>

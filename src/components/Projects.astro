---
import { icons } from './icons';
import { projects } from '../content/resume';

/**
 * Windowed card browser, after the "code" tab on simon.lecoq.io:
 * a sidebar of entries on the left, a grid of typed cards on the right,
 * an "overview" entry whose cards are the projects themselves, and a
 * staggered fade-in on every switch.
 */

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

/** GitHub's language dot colours, so the badge reads the way it does on the repo page. */
const langColor: Record<string, string> = {
  Python: '#3572A5',
  JavaScript: '#F1E05A',
  TypeScript: '#3178C6',
  Swift: '#F05138',
  Go: '#00ADD8',
  Java: '#B07219',
};
---

<div class="browser" data-projects>
  <aside class="side">
    <button type="button" class="side-item active" data-select="overview" aria-current="true">
      <span class="fill" aria-hidden="true"></span>
      <span class="mark" aria-hidden="true">■</span>
      <span class="txt">overview</span>
    </button>
    <span class="side-label">projects</span>
    {
      projects.map((p) => (
        <button type="button" class="side-item" data-select={p.id}>
          <span class="fill" aria-hidden="true" />
          <span class="mark" aria-hidden="true">
            ■
          </span>
          <span class="txt">{p.name}</span>
        </button>
      ))
    }
  </aside>

  <div class="panels">
    {/* ---------- overview: one card per project ---------- */}
    <div class="cards" data-panel="overview">
      {
        projects.map((p) => (
          <button type="button" class="card as-link" data-select={p.id}>
            <span class="card-head">
              <svg class="i" viewBox="0 0 16 16" aria-hidden="true">
                <path d={icons.terminal} />
              </svg>
              <span class="card-name">{p.name}</span>
              <span class="card-year">{p.year}</span>
            </span>
            <span class="card-body">{p.summary}</span>
          </button>
        ))
      }
    </div>

    {/* ---------- one panel per project ---------- */}
    {
      projects.map((p) => (
        // Column count comes from how many half-width cards this project has.
        // `auto-fit` cannot help here: the full-width "about" card spans every
        // track, so no track is ever empty for it to collapse.
        <div
          class="cards"
          data-panel={p.id}
          data-cols={Math.min(
            [p.github, p.links, p.private, true].filter(Boolean).length,
            3,
          )}
          hidden
        >
          <article class="card wide">
            <div class="card-head">
              <svg class="i" viewBox="0 0 16 16" aria-hidden="true">
                <path d={icons.about} />
              </svg>
              <span class="card-name">about</span>
              <span class="card-year">{p.year}</span>
            </div>
            <div class="card-body">{p.about}</div>
          </article>

          {/* Optional screenshot. Set `preview` in the data file to switch it on. */}
          {p.preview && (
            <article class="card wide">
              <div class="card-head">
                <svg class="i" viewBox="0 0 16 16" aria-hidden="true">
                  <path d={icons.image} />
                </svg>
                <span class="card-name">preview</span>
              </div>
              <div class="card-body flush">
                <img class="shot" src={p.preview.src} alt={p.preview.alt} loading="lazy" />
              </div>
            </article>
          )}

          {p.github && (
            <article class="card">
              <div class="card-head">
                <svg class="i" viewBox="0 0 16 16" aria-hidden="true">
                  <path d={icons.github} />
                </svg>
                <span class="card-name">github</span>
              </div>
              <div class="card-body">
                <a
                  class="repo"
                  href={`https://github.com/${p.github.repo}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {p.github.repo}
                </a>
                <dl class="meta">
                  <div>
                    <dt>language</dt>
                    <dd>
                      <span
                        class="dot"
                        style={`background:${langColor[p.github.language] ?? 'var(--dim)'}`}
                        aria-hidden="true"
                      />
                      {p.github.language}
                    </dd>
                  </div>
                  <div>
                    <dt>commits</dt>
                    <dd>{p.github.commits}</dd>
                  </div>
                  <div>
                    <dt>created</dt>
                    <dd>{fmt(p.github.created)}</dd>
                  </div>
                  <div>
                    <dt>updated</dt>
                    <dd>{fmt(p.github.updated)}</dd>
                  </div>
                </dl>
              </div>
            </article>
          )}

          {p.links && (
            <article class="card">
              <div class="card-head">
                <svg class="i" viewBox="0 0 16 16" aria-hidden="true">
                  <path d={icons.link} />
                </svg>
                <span class="card-name">links</span>
              </div>
              <div class="card-body">
                {p.links.map((l) => (
                  <div>
                    <a href={l.href} target="_blank" rel="noopener noreferrer">
                      {l.label}
                    </a>
                  </div>
                ))}
              </div>
            </article>
          )}

          {p.private && (
            <article class="card">
              <div class="card-head">
                <svg class="i" viewBox="0 0 16 16" aria-hidden="true">
                  <path d={icons.lock} />
                </svg>
                <span class="card-name">source</span>
              </div>
              <div class="card-body comment">Private client work — no public repository.</div>
            </article>
          )}

          <article class="card">
            <div class="card-head">
              <svg class="i" viewBox="0 0 16 16" aria-hidden="true">
                <path d={icons.stack} />
              </svg>
              <span class="card-name">stack</span>
            </div>
            <div class="card-body">
              <ul class="tags">
                {p.stack.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
          </article>
        </div>
      ))
    }
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-projects]');

  if (root) {
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
    const sideItems = root.querySelectorAll<HTMLElement>('.side-item[data-select]');

    function show(id: string) {
      panels.forEach((panel) => {
        const active = panel.dataset.panel === id;
        panel.hidden = !active;
        if (!active) return;

        // Re-trigger the staggered entrance on every switch.
        panel.querySelectorAll<HTMLElement>('.card').forEach((card, i) => {
          card.style.animation = 'none';
          void card.offsetWidth; // force reflow so the animation restarts
          card.style.animation = '';
          card.style.animationDelay = `${Math.min(i, 8) * 55}ms`;
        });
      });

      sideItems.forEach((item) => {
        const active = item.dataset.select === id;
        item.classList.toggle('active', active);
        if (active) item.setAttribute('aria-current', 'true');
        else item.removeAttribute('aria-current');
      });
    }

    root.querySelectorAll<HTMLElement>('[data-select]').forEach((el) => {
      el.addEventListener('click', () => show(el.dataset.select!));
    });
  }
</script>

<style>
  .browser {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: var(--sp-5);
    align-items: start;
  }

  /* ---------- sidebar ---------- */

  .side {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--sp-2);
    border-left: 2px solid var(--border);
    padding-left: var(--sp-3);
    position: sticky;
    top: var(--sp-4);
  }

  .side-label {
    color: var(--faint);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: var(--sp-3) 0 var(--sp-1);
  }

  /* Sweep-fill hover, after the aside on simon.lecoq.io.
     He animates `background-position` on an over-wide gradient, which repaints
     every frame and stutters under a fast pointer. A transform on a pseudo-layer
     is composited on the GPU instead, so it stays fluid however quickly you
     sweep the list, and reverses cleanly mid-flight rather than snapping. */
  .side-item {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: baseline;
    gap: 1ch;
    font: inherit;
    font-size: var(--step--1);
    text-align: left;
    color: var(--dim);
    /* Already a box at rest — a shade darker than the page, as on
       simon.lecoq.io. The hover fill then wipes chrome over it. */
    background: var(--rest);
    border: 0;
    /* The rules above and below, which appear on hover in the fill colour. */
    border-top: 2px solid transparent;
    border-bottom: 2px solid transparent;
    padding: var(--sp-1) var(--sp-2);
    cursor: pointer;
    /* The rules are NOT transitioned in either direction: they appear the moment
       the cursor arrives and vanish the moment it leaves, so a fast sweep reads
       as a single highlight travelling down the list rather than several rows
       lit at once. Only the fill and the text colour ease. */
    transition: color 0.32s ease-out;
  }

  .fill {
    position: absolute;
    /* Inset vertically so the fill never touches the rules — that gap is what
       makes them read as separate rules rather than one thick block. */
    inset: 3px 0;
    z-index: -1;
    background: var(--chrome);
    transform: scaleX(0);
    transform-origin: left center; /* wipes in from the left */
    transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .mark {
    font-size: 0.7em;
    color: var(--faint);
    transition: color 0.32s ease-out;
  }

  .side-item:hover .fill,
  .side-item.active .fill {
    transform: scaleX(1);
  }

  .side-item:hover,
  .side-item.active {
    color: var(--chrome-ink);
    border-color: var(--chrome);
  }

  .side-item:hover .mark,
  .side-item.active .mark {
    color: var(--chrome-ink);
  }

  .side-item.active {
    font-weight: 700;
  }

  /* ---------- cards ---------- */

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--sp-3);
  }

  /* Project panels: exactly as many columns as they have half-width cards, so
     two cards (github + stack) span the full width instead of leaving a dead
     column on the right. */
  .cards[data-cols='1'] {
    grid-template-columns: minmax(0, 1fr);
  }

  .cards[data-cols='2'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cards[data-cols='3'] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cards[hidden] {
    display: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    text-align: left;
    /* A <button> carries UA padding, which was leaving a gap of surface colour
       around the title bar on the overview cards. */
    padding: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    overflow: hidden;
    animation: card-in 0.34s ease-out both;
  }

  .card.wide {
    grid-column: 1 / -1;
  }

  .card.as-link {
    font: inherit;
    color: inherit;
    cursor: pointer;
    transition: filter 0.5s ease-out, transform 0.2s ease-out, box-shadow 0.2s ease-out;
  }

  .card.as-link:hover {
    filter: brightness(1.08);
    transform: translateY(-2px);
    box-shadow: 0 14px 26px -18px var(--shadow);
  }

  /* Solid title bar — this is what makes the card read as a window rather than
     a panel. Uses the muted chrome, not the accent: nine saturated bars is a shout. */
  .card-head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    width: 100%;
    padding: var(--sp-1) var(--sp-3) 5px;
    color: var(--chrome-ink);
    background: var(--chrome);
  }

  .i {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    fill: currentColor;
    transform: translateY(2px);
  }

  .card-name {
    font-weight: 700;
    font-size: var(--step--1);
    line-height: 1.35;
  }

  .card-year {
    margin-left: auto;
    font-size: var(--step--2);
    opacity: 0.75;
    flex-shrink: 0;
  }

  .card-body {
    padding: var(--sp-3);
    color: var(--ink);
    flex-grow: 1;
  }

  .card-body.flush {
    padding: 0;
  }

  .card.as-link .card-body {
    color: var(--dim);
  }

  .shot {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- github card ---------- */

  .repo {
    display: inline-block;
    margin-bottom: var(--sp-3);
    word-break: break-all;
  }

  .meta {
    margin: 0;
    display: grid;
    gap: 2px;
    font-size: var(--step--1);
  }

  .meta > div {
    display: flex;
    gap: 1ch;
  }

  .meta dt {
    min-width: 10ch;
    color: var(--faint);
  }

  .meta dd {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6ch;
    color: var(--ink);
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  /* These come after the [data-cols] rules, so they win on narrow screens
     without needing !important. */
  @media (max-width: 900px) {
    .cards[data-cols='3'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .cards[data-cols] {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    .browser {
      grid-template-columns: 1fr;
    }

    /* The sidebar becomes a horizontally scrollable strip, rather than nine
       stacked lines pushing the cards off-screen. */
    .side {
      position: static;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      gap: var(--sp-1);
      border-left: 0;
      border-bottom: 2px solid var(--border);
      padding: 0 0 var(--sp-3);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .side::-webkit-scrollbar {
      display: none;
    }

    .side-label {
      display: none;
    }

    .side-item {
      white-space: nowrap;
      border: 1px solid var(--border);
    }
  }
</style>

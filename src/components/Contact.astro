---
import { icons } from './icons';
import { profile, resumePdf } from '../content/resume';

/**
 * The website link used to be a globe, which said "internet" rather than
 * "this site". It is now the same terminal-prompt mark as the favicon, so the
 * brand reads consistently from tab, to status bar, to here.
 */
const iconFor: Record<string, string> = {
  github: 'github',
  linkedin: 'linkedin',
  website: 'terminal',
};

const items = [
  ...profile.links.map((l) => ({
    icon: iconFor[l.label] ?? 'link',
    label: l.label,
    value: l.href.replace(/^https?:\/\//, ''),
    href: l.href,
    external: true,
  })),
  {
    icon: 'file',
    label: 'resume',
    value: 'alexandre_gravereaux.pdf',
    href: resumePdf,
    external: false,
  },
];
---

<ul class="contact">
  {
    items.map((item) => (
      <li>
        <a
          class="row"
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          <svg class="logo" viewBox="0 0 16 16" aria-hidden="true">
            <path d={icons[item.icon]} />
          </svg>
          <span class="key">{item.label}</span>
          <span class="val">{item.value}</span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-width: var(--measure);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 1ch;
    padding: var(--sp-2) var(--sp-3);
    color: var(--dim);
    border: 1px solid transparent;
    border-radius: 4px;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .row:hover {
    color: var(--ink);
    background: var(--surface);
    border-color: var(--border);
  }

  .logo {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    fill: var(--dim);
    transition: fill 0.15s ease;
  }

  .row:hover .logo {
    fill: var(--accent);
  }

  .key {
    min-width: 10ch;
    color: var(--accent);
    font-weight: 700;
  }

  .val {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .arrow {
    margin-left: auto;
    opacity: 0;
    color: var(--accent);
    transform: translateX(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .row:hover .arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>

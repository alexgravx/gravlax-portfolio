---
/**
 * Interactive command prompt.
 *   mode="docked" — pinned to the bottom of a scrolling page (mockup A)
 *   mode="full"   — the page IS the terminal (mockup B)
 */
interface Props {
  mode: 'docked' | 'full';
  greeting?: boolean;
}

const { mode, greeting = false } = Astro.props;
---

<section class:list={['repl', mode]} data-repl data-mode={mode} aria-label="Command prompt">
  <div class="repl-log" data-log aria-live="polite">
    {
      greeting && (
        <div class="repl-block">
          <p>
            Type <span class="cmd-name">help</span> to list commands.
            {mode === 'docked' && <> Or just scroll.</>}
          </p>
        </div>
      )
    }
  </div>

  <form class="repl-form" data-form autocomplete="off">
    <label class="prompt-user" for={`repl-input-${mode}`}>visitor@gravlax:~$</label>
    <input
      id={`repl-input-${mode}`}
      class="repl-input"
      data-input
      type="text"
      spellcheck="false"
      autocapitalize="off"
      autocorrect="off"
      aria-label="Enter a command"
    />
  </form>
</section>

<script>
  import { runCommand, commandNames, esc } from '../scripts/commands';

  document.querySelectorAll<HTMLElement>('[data-repl]').forEach((repl) => {
    const log = repl.querySelector<HTMLElement>('[data-log]')!;
    const form = repl.querySelector<HTMLFormElement>('[data-form]')!;
    const input = repl.querySelector<HTMLInputElement>('[data-input]')!;
    const docked = repl.dataset.mode === 'docked';

    const history: string[] = [];
    let cursor = 0;

    function emit(command: string, html: string | null) {
      const block = document.createElement('div');
      block.className = 'repl-block';
      block.innerHTML =
        `<div class="prompt-line"><span class="prompt-user">visitor@gravlax:~$</span>` +
        `<span class="prompt-cmd">${esc(command)}</span></div>` +
        (html ? `<div class="repl-out">${html}</div>` : '');
      log.append(block);

      // The docked prompt is fixed at the bottom, so the log scrolls itself;
      // the full-page terminal scrolls the window instead.
      if (docked) log.scrollTop = log.scrollHeight;
      else block.scrollIntoView({ block: 'nearest' });
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const raw = input.value;
      if (!raw.trim()) return;

      history.push(raw);
      cursor = history.length;
      input.value = '';

      const { html } = runCommand(raw);
      if (html === null) {
        log.replaceChildren();
        return;
      }
      emit(raw, html);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
        e.preventDefault();
        if (!history.length) return;
        cursor += e.key === 'ArrowUp' ? -1 : 1;
        cursor = Math.max(0, Math.min(cursor, history.length));
        input.value = history[cursor] ?? '';
        return;
      }

      if (e.key === 'Tab') {
        e.preventDefault();
        const stem = input.value.trim().toLowerCase();
        if (!stem) return;
        const hit = commandNames.find((c) => c.startsWith(stem));
        if (hit) input.value = hit;
      }
    });

    // Clicking anywhere in the terminal body focuses the prompt, but not when
    // the visitor is selecting text or following a link.
    repl.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      if (el.closest('a') || window.getSelection()?.toString()) return;
      input.focus();
    });

    if (!docked) input.focus();
  });
</script>

<style>
  .repl {
    display: flex;
    flex-direction: column;
  }

  .repl-log {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .repl-block {
    animation: rise 0.18s ease-out;
  }

  .repl-out {
    margin-top: var(--sp-2);
  }

  .repl-form {
    display: flex;
    align-items: baseline;
    gap: 0.8ch;
  }

  .repl-input {
    flex: 1;
    min-width: 0;
    font: inherit;
    color: var(--ink);
    background: transparent;
    border: 0;
    padding: 0;
    caret-color: var(--accent);
  }

  .repl-input:focus {
    outline: none;
  }

  /* Docked: a fixed bar across the bottom of the scrolling page. */
  .repl.docked {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 400;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    background: var(--surface);
    border-top: 1px solid var(--border);
    box-shadow: 0 -12px 32px -20px rgba(0, 0, 0, 0.6);
  }

  .repl.docked .repl-log {
    max-height: 42vh;
    overflow-y: auto;
    margin: 0 auto;
    width: 100%;
    max-width: 88ch;
  }

  .repl.docked .repl-log:empty {
    display: none;
  }

  .repl.docked .repl-form {
    margin: 0 auto;
    width: 100%;
    max-width: 88ch;
  }

  /* Full: the terminal is the page. */
  .repl.full {
    gap: var(--sp-5);
    min-height: 60vh;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }
</style>

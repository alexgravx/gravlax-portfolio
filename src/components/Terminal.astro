---
import { profile } from '../content/resume';

/**
 * The terminal window. It is the whole first screen.
 *
 * The opening output is a neofetch-style block: ASCII monogram on the left,
 * system info on the right. The cursor is a real inverse-video block that
 * tracks the caret position (safe in `ch` units because the font is monospace).
 */

const logo = String.raw` █████╗  ██████╗
██╔══██╗██╔════╝
███████║██║  ███╗
██╔══██║██║   ██║
██║  ██║╚██████╔╝
╚═╝  ╚═╝ ╚═════╝`;

const info: Array<[string, string]> = [
  ['name', profile.name],
  ['role', profile.title],
  ['location', profile.location],
  ['edu', 'MEng Computer Science, Cornell Tech'],
  ['prev', 'Forvis Mazars · Paris Digital Lab · ViaRézo'],
  ['shell', 'zsh'],
  ['theme', 'gravlax-dark'],
];

const promptLabel = `visitor@${profile.handle}:~$`;
---

<section class="term" data-term aria-label="Interactive terminal">
  <header class="term-bar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="term-title">visitor@{profile.handle} — zsh — 96×28</span>
    <button type="button" class="term-clear" data-clear>clear</button>
  </header>

  <div class="term-body" data-body>
    <div class="term-log" data-log aria-live="polite">
      <div class="term-block">
        <div class="term-cmdline">
          <span class="term-prompt">{promptLabel}</span><span class="term-typed">neofetch</span>
        </div>

        <div class="neofetch">
          <pre class="nf-logo" aria-hidden="true">{logo}</pre>
          <dl class="nf-info">
            <div class="nf-head">
              <span class="nf-user">visitor</span>@<span class="nf-host">{profile.handle}</span>
            </div>
            <div class="nf-rule" aria-hidden="true">───────────────────────────────</div>
            {
              info.map(([k, v]) => (
                <div class="nf-row">
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <p class="term-hint comment">
          Type <span class="cmd-name">help</span> for commands. <span class="term-hint-scroll">Scroll for the rest.</span>
        </p>
      </div>
    </div>

    <form class="term-form" data-form autocomplete="off">
      <label class="term-prompt" for="term-input">{promptLabel}</label>
      <span class="term-field">
        <input
          id="term-input"
          class="term-input"
          data-input
          type="text"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          aria-label="Enter a command"
        />
        <span class="term-cursor" data-cursor aria-hidden="true"></span>
      </span>
    </form>
  </div>
</section>

<script>
  import { runCommand, commandNames, esc } from '../scripts/commands';

  const term = document.querySelector<HTMLElement>('[data-term]');

  if (term) {
    const log = term.querySelector<HTMLElement>('[data-log]')!;
    const body = term.querySelector<HTMLElement>('[data-body]')!;
    const form = term.querySelector<HTMLFormElement>('[data-form]')!;
    const input = term.querySelector<HTMLInputElement>('[data-input]')!;
    const cursor = term.querySelector<HTMLElement>('[data-cursor]')!;
    const clearBtn = term.querySelector<HTMLButtonElement>('[data-clear]')!;
    const label = term.querySelector<HTMLElement>('.term-prompt')!.textContent!;

    const history: string[] = [];
    let cursorIdx = 0;

    /** Inverse-video block: sits ON the character at the caret. */
    function drawCursor() {
      const at = input.selectionStart ?? input.value.length;
      cursor.style.transform = `translateX(${at}ch)`;
      cursor.textContent = input.value[at] ?? ' ';
      // Restart the blink so the cursor is solid while actively typing.
      cursor.style.animation = 'none';
      void cursor.offsetWidth;
      cursor.style.animation = '';
    }

    function emit(command: string, html: string | null) {
      const block = document.createElement('div');
      block.className = 'term-block';
      block.innerHTML =
        `<div class="term-cmdline"><span class="term-prompt">${esc(label)}</span>` +
        `<span class="term-typed">${esc(command)}</span></div>` +
        (html ? `<div class="term-out">${html}</div>` : '');
      log.append(block);
      body.scrollTop = body.scrollHeight;
    }

    function clear() {
      log.replaceChildren();
      input.focus();
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const raw = input.value;

      // Bare Enter reprints the prompt on the next line, with no gap — like a shell.
      if (!raw.trim()) {
        emit('', null);
        input.value = '';
        drawCursor();
        return;
      }

      history.push(raw);
      cursorIdx = history.length;
      input.value = '';

      const { html } = runCommand(raw);
      if (html === null) clear();
      else emit(raw, html);
      drawCursor();
    });

    input.addEventListener('keydown', (e) => {
      // Ctrl+L clears the screen, as in any real terminal.
      if (e.ctrlKey && e.key.toLowerCase() === 'l') {
        e.preventDefault();
        clear();
        return;
      }

      if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
        e.preventDefault();
        if (!history.length) return;
        cursorIdx = Math.max(0, Math.min(cursorIdx + (e.key === 'ArrowUp' ? -1 : 1), history.length));
        input.value = history[cursorIdx] ?? '';
        requestAnimationFrame(drawCursor);
        return;
      }

      if (e.key === 'Tab') {
        e.preventDefault();
        const stem = input.value.trim().toLowerCase();
        if (!stem) return;
        const hit = commandNames.find((c) => c.startsWith(stem));
        if (hit) input.value = hit;
      }

      requestAnimationFrame(drawCursor);
    });

    input.addEventListener('input', drawCursor);
    input.addEventListener('click', drawCursor);
    input.addEventListener('focus', drawCursor);
    clearBtn.addEventListener('click', clear);

    body.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      if (el.closest('a') || el.closest('button') || window.getSelection()?.toString()) return;
      input.focus();
    });

    drawCursor();
  }
</script>

<style>
  .term {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 24px 60px -34px var(--shadow);
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    background: var(--raised);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .lights {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg);
  }

  .term-title {
    flex: 1;
    text-align: center;
    color: var(--faint);
    font-size: var(--step--2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .term-clear {
    flex-shrink: 0;
    font: inherit;
    font-size: var(--step--2);
    color: var(--faint);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 0 var(--sp-2);
    cursor: pointer;
  }

  .term-clear:hover {
    color: var(--accent);
    border-color: var(--border);
  }

  .term-body {
    flex: 1;
    overflow-y: auto;
    padding: var(--sp-4);
    cursor: text;
    scrollbar-width: thin;
  }

  /* A shell has no gaps between lines. Spacing comes from the output blocks. */
  .term-block {
    animation: rise 0.18s ease-out;
  }

  .term-cmdline {
    display: flex;
    gap: 0.8ch;
    flex-wrap: wrap;
  }

  .term-out {
    margin: var(--sp-2) 0 var(--sp-4);
  }

  .term-prompt {
    color: var(--accent);
    font-weight: 700;
    white-space: nowrap;
  }

  .term-typed {
    font-weight: 700;
  }

  /* ---------- neofetch ---------- */

  .neofetch {
    display: flex;
    gap: var(--sp-5);
    margin: var(--sp-3) 0 var(--sp-4);
    flex-wrap: wrap;
  }

  .nf-logo {
    margin: 0;
    color: var(--accent);
    font-size: var(--step--1);
    line-height: 1.15;
    white-space: pre;
    flex-shrink: 0;
  }

  .nf-info {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.5;
    min-width: 0;
  }

  .nf-head {
    font-weight: 700;
  }

  .nf-user {
    color: var(--accent);
  }

  .nf-host {
    color: var(--accent);
  }

  .nf-rule {
    color: var(--faint);
    overflow: hidden;
    white-space: nowrap;
  }

  .nf-row {
    display: flex;
    gap: 1ch;
  }

  .nf-row dt {
    color: var(--accent);
    font-weight: 700;
    min-width: 9ch;
  }

  .nf-row dd {
    margin: 0;
    color: var(--ink);
  }

  .term-hint {
    margin: 0;
  }

  /* ---------- prompt + block cursor ---------- */

  .term-form {
    display: flex;
    align-items: baseline;
    gap: 0.8ch;
    margin-top: var(--sp-1);
  }

  .term-field {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .term-input {
    width: 100%;
    font: inherit;
    color: var(--ink);
    background: transparent;
    border: 0;
    padding: 0;
    caret-color: transparent; /* replaced by the block below */
  }

  .term-input:focus {
    outline: none;
  }

  .term-cursor {
    position: absolute;
    top: 0;
    left: 0;
    width: 1ch;
    color: var(--bg);
    background: var(--accent);
    white-space: pre;
    pointer-events: none;
    animation: blink 1.05s step-end infinite;
  }

  /* Hollow the cursor out when the prompt is not focused, as terminals do. */
  .term-form:not(:focus-within) .term-cursor {
    background: transparent;
    color: transparent;
    box-shadow: inset 0 0 0 1px var(--dim);
    animation: none;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }

  @media (max-width: 640px) {
    .term-title {
      display: none;
    }

    .nf-logo {
      display: none;
    }

    .term-hint-scroll {
      display: none;
    }
  }
</style>

---
import { profile } from '../content/resume';

/**
 * A real terminal window on the homepage: title bar, traffic lights, and a
 * working prompt. Styled to sit inside the page rather than cosplay macOS.
 */
const promptLabel = `visitor@${profile.handle}:~$`;
---

<section class="term" data-term aria-label="Interactive terminal">
  <header class="term-bar">
    <span class="lights" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
    <span class="term-title">visitor@{profile.handle} — zsh — 80×24</span>
    <button type="button" class="term-clear" data-clear aria-label="Clear terminal">clear</button>
  </header>

  <div class="term-body" data-body>
    <div class="term-log" data-log aria-live="polite">
      <div class="term-block intro">
        <p class="comment">
          Last login: today on ttys001<br />
          Type <span class="cmd-name">help</span> for commands — or just scroll.
        </p>
      </div>
    </div>

    <form class="term-form" data-form autocomplete="off">
      <label class="term-prompt" for="term-input">{promptLabel}</label>
      <input
        id="term-input"
        class="term-input"
        data-input
        type="text"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        aria-label="Enter a command"
      />
    </form>
  </div>
</section>

<script>
  import { runCommand, commandNames, esc } from '../scripts/commands';

  const term = document.querySelector<HTMLElement>('[data-term]');
  if (term) {
    const log = term.querySelector<HTMLElement>('[data-log]')!;
    const body = term.querySelector<HTMLElement>('[data-body]')!;
    const form = term.querySelector<HTMLFormElement>('[data-form]')!;
    const input = term.querySelector<HTMLInputElement>('[data-input]')!;
    const clearBtn = term.querySelector<HTMLButtonElement>('[data-clear]')!;
    const label = term.querySelector<HTMLElement>('.term-prompt')!.textContent!;

    const history: string[] = [];
    let cursor = 0;

    function emit(command: string, html: string) {
      const block = document.createElement('div');
      block.className = 'term-block';
      block.innerHTML =
        `<div class="term-cmdline"><span class="term-prompt">${esc(label)}</span>` +
        `<span class="term-typed">${esc(command)}</span></div>` +
        (html ? `<div class="term-out">${html}</div>` : '');
      log.append(block);
      body.scrollTop = body.scrollHeight;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const raw = input.value;
      if (!raw.trim()) return;

      history.push(raw);
      cursor = history.length;
      input.value = '';

      const { html } = runCommand(raw);
      if (html === null) {
        log.replaceChildren();
        return;
      }
      emit(raw, html);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
        e.preventDefault();
        if (!history.length) return;
        cursor = Math.max(0, Math.min(cursor + (e.key === 'ArrowUp' ? -1 : 1), history.length));
        input.value = history[cursor] ?? '';
        return;
      }
      if (e.key === 'Tab') {
        e.preventDefault();
        const stem = input.value.trim().toLowerCase();
        if (!stem) return;
        const hit = commandNames.find((c) => c.startsWith(stem));
        if (hit) input.value = hit;
      }
    });

    clearBtn.addEventListener('click', () => {
      log.replaceChildren();
      input.focus();
    });

    // Click the terminal body to focus the prompt — unless selecting or following a link.
    body.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      if (el.closest('a') || window.getSelection()?.toString()) return;
      input.focus();
    });
  }
</script>

<style>
  .term {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 18px 40px -28px var(--shadow);
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    background: var(--raised);
    border-bottom: 1px solid var(--border);
  }

  .lights {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg);
  }

  .term-title {
    flex: 1;
    text-align: center;
    color: var(--faint);
    font-size: var(--step--2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .term-clear {
    flex-shrink: 0;
    font: inherit;
    font-size: var(--step--2);
    color: var(--faint);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 0 var(--sp-2);
    cursor: pointer;
  }

  .term-clear:hover {
    color: var(--accent);
    border-color: var(--border);
  }

  .term-body {
    height: 21rem;
    overflow-y: auto;
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    cursor: text;
    scrollbar-width: thin;
  }

  .term-log {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .term-log:empty {
    display: none;
  }

  .term-block {
    animation: rise 0.18s ease-out;
  }

  .term-cmdline {
    display: flex;
    gap: 0.8ch;
    flex-wrap: wrap;
  }

  .term-out {
    margin-top: var(--sp-2);
  }

  /* The prompt follows the last output, as in a real shell — it does not
     float at the bottom of the window. */
  .term-form {
    display: flex;
    align-items: baseline;
    gap: 0.8ch;
  }

  .term-prompt {
    color: var(--accent);
    font-weight: 700;
    white-space: nowrap;
  }

  .term-typed {
    font-weight: 700;
  }

  .term-input {
    flex: 1;
    min-width: 0;
    font: inherit;
    color: var(--ink);
    background: transparent;
    border: 0;
    padding: 0;
    caret-color: var(--accent);
  }

  .term-input:focus {
    outline: none;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }

  @media (max-width: 560px) {
    .term-body {
      height: 17rem;
    }

    .term-title {
      display: none;
    }
  }
</style>

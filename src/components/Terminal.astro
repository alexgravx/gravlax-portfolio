---
import { profile, neofetch } from '../content/resume';

/**
 * The terminal window. It is the whole first screen.
 *
 * It runs a small real shell over a virtual filesystem (see scripts/fs.ts):
 * ls / cd / cat / tree / pwd all work, and the prompt reflects the cwd.
 * The cursor is a true inverse-video block that sits ON the character at the
 * caret — safe in `ch` units because the font is monospace.
 */

// Built line-by-line rather than as one template literal: a backtick cannot be
// escaped inside String.raw without the backslash surviving into the output,
// which is what turned the salmon into punctuation soup. Apostrophes it is.
//
// The monogram and the fish are two separate <pre> blocks stacked in a centred
// column, so the AG sits over the middle of the salmon whatever their widths —
// no hand-counted padding to drift out of alignment.
const monogram = [
  ' █████╗  ██████╗',
  '██╔══██╗██╔════╝',
  '███████║██║  ███╗',
  '██╔══██║██║   ██║',
  '██║  ██║╚██████╔╝',
  '╚═╝  ╚═╝ ╚═════╝',
].join('\n');

const salmon = [
  '      /"*._         _',
  "  .-*'      '*-.._.-'/",
  ' < * ))     ,       (',
  '  \'*-._\'._(__.--*"\'.\\;',
  "       ';/     ''--'",
].join('\n');

const initialPrompt = `visitor@${profile.handle}:~$`;
---

<section class="term" data-term aria-label="Interactive terminal">
  <header class="term-bar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="term-title">visitor@{profile.handle} — zsh — 96×28</span>
    <button type="button" class="term-clear" data-clear>clear</button>
  </header>

  <div class="term-body" data-body>
    <div class="term-log" data-log aria-live="polite">
      <div class="term-block">
        <div class="neofetch">
          <div class="nf-art" aria-hidden="true">
            <pre class="nf-mono">{monogram}</pre>
            <pre class="nf-fish">{salmon}</pre>
          </div>
          <dl class="nf-info">
            <div class="nf-head">
              <span class="nf-user">visitor</span>@<span class="nf-host">{profile.handle}</span>
            </div>
            <div class="nf-rule" aria-hidden="true">───────────────────────────────</div>
            {
              neofetch.map(([k, v]) => (
                <div class="nf-row">
                  <dt>{k}</dt>
                  <dd data-res={k === 'resolution' ? '' : undefined}>{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <p class="term-hint comment">
          Type <span class="cmd-name">help</span>, or poke around with{' '}
          <span class="cmd-name">ls</span> and <span class="cmd-name">cd</span>.{' '}
          <span class="term-hint-scroll">Scroll for the rest.</span>
        </p>
      </div>
    </div>

    <form class="term-form" data-form autocomplete="off">
      <label class="term-prompt" data-prompt for="term-input">{initialPrompt}</label>
      <span class="term-field">
        <input
          id="term-input"
          class="term-input"
          data-input
          type="text"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          aria-label="Enter a command"
        />
        <span class="term-cursor" data-cursor aria-hidden="true"></span>
      </span>
    </form>
  </div>
</section>

<script>
  import { createShell, run, prompt, completions, esc } from '../scripts/commands';

  const term = document.querySelector<HTMLElement>('[data-term]');

  if (term) {
    const log = term.querySelector<HTMLElement>('[data-log]')!;
    const body = term.querySelector<HTMLElement>('[data-body]')!;
    const form = term.querySelector<HTMLFormElement>('[data-form]')!;
    const input = term.querySelector<HTMLInputElement>('[data-input]')!;
    const cursor = term.querySelector<HTMLElement>('[data-cursor]')!;
    const promptEl = term.querySelector<HTMLElement>('[data-prompt]')!;
    const clearBtn = term.querySelector<HTMLButtonElement>('[data-clear]')!;

    const shell = createShell();
    const history: string[] = [];
    let histIdx = 0;

    // Real neofetch reports the display, so ours does too: the visitor's own
    // screen, with the DPR suffix macOS-style (1512x982@2x).
    const res = term.querySelector<HTMLElement>('[data-res]');
    if (res) {
      const dpr = Math.round(devicePixelRatio * 100) / 100;
      res.textContent = `${screen.width}x${screen.height}${dpr !== 1 ? `@${dpr}x` : ''}`;
    }

    /** Inverse-video block, sitting on the character at the caret. */
    function drawCursor() {
      const at = input.selectionStart ?? input.value.length;
      cursor.style.transform = `translateX(${at}ch)`;
      cursor.textContent = input.value[at] ?? ' ';
      cursor.style.animation = 'none';
      void cursor.offsetWidth;
      cursor.style.animation = '';
    }

    function syncPrompt() {
      promptEl.textContent = prompt(shell);
    }

    function emit(command: string, html: string | null, label: string) {
      const block = document.createElement('div');
      block.className = 'term-block';
      block.innerHTML =
        `<div class="term-cmdline"><span class="term-prompt">${esc(label)}</span>` +
        `<span class="term-typed">${esc(command)}</span></div>` +
        (html ? `<div class="term-out">${html}</div>` : '');
      log.append(block);
      body.scrollTop = body.scrollHeight;
    }

    function clear() {
      log.replaceChildren();
      input.focus();
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const raw = input.value;
      const label = prompt(shell); // capture BEFORE cd changes it

      if (!raw.trim()) {
        emit('', null, label);
        input.value = '';
        drawCursor();
        return;
      }

      history.push(raw);
      histIdx = history.length;
      input.value = '';

      const result = run(shell, raw);
      if (result.clear) clear();
      else emit(raw, result.html, label);

      syncPrompt();
      drawCursor();
    });

    input.addEventListener('keydown', (e) => {
      if (e.ctrlKey && e.key.toLowerCase() === 'l') {
        e.preventDefault();
        clear();
        return;
      }

      if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
        e.preventDefault();
        if (!history.length) return;
        histIdx = Math.max(0, Math.min(histIdx + (e.key === 'ArrowUp' ? -1 : 1), history.length));
        input.value = history[histIdx] ?? '';
        requestAnimationFrame(drawCursor);
        return;
      }

      if (e.key === 'Tab') {
        e.preventDefault();
        // Complete the last word, so `cd pro<Tab>` works as well as `pro<Tab>`.
        const parts = input.value.split(/(\s+)/);
        const lastIdx = parts.length - 1;
        const stem = (parts[lastIdx] ?? '').toLowerCase();
        if (!stem.trim()) return;

        const hit = completions(shell).find((c) => c.toLowerCase().startsWith(stem));
        if (hit) {
          parts[lastIdx] = hit;
          input.value = parts.join('');
          requestAnimationFrame(drawCursor);
        }
        return;
      }

      requestAnimationFrame(drawCursor);
    });

    input.addEventListener('input', drawCursor);
    input.addEventListener('click', drawCursor);
    input.addEventListener('focus', drawCursor);
    clearBtn.addEventListener('click', clear);

    body.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      if (el.closest('a') || el.closest('button') || window.getSelection()?.toString()) return;
      input.focus();
    });

    syncPrompt();
    drawCursor();
  }
</script>

<style>
  .term {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 24px 60px -34px var(--shadow);
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    background: var(--raised);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .lights {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg);
  }

  .term-title {
    flex: 1;
    text-align: center;
    color: var(--faint);
    font-size: var(--step--2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .term-clear {
    flex-shrink: 0;
    font: inherit;
    font-size: var(--step--2);
    color: var(--faint);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 0 var(--sp-2);
    cursor: pointer;
  }

  .term-clear:hover {
    color: var(--accent);
    border-color: var(--border);
  }

  .term-body {
    flex: 1;
    overflow-y: auto;
    padding: var(--sp-4);
    cursor: text;
    scrollbar-width: thin;
    line-height: 1.45;
  }

  /* ---------- neofetch ---------- */

  .neofetch {
    display: flex;
    gap: var(--sp-5);
    margin-bottom: var(--sp-3);
    flex-wrap: wrap;
  }

  /* Centred column: the monogram sits over the middle of the salmon. */
  .nf-art {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
    flex-shrink: 0;
  }

  .nf-mono,
  .nf-fish {
    margin: 0;
    color: var(--accent);
    font-size: var(--step--1);
    line-height: 1.15;
    white-space: pre;
  }

  .nf-info {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.5;
    min-width: 0;
  }

  .nf-head {
    font-weight: 700;
  }

  .nf-user,
  .nf-host {
    color: var(--accent);
  }

  .nf-rule {
    color: var(--faint);
    overflow: hidden;
    white-space: nowrap;
  }

  .nf-row {
    display: flex;
    gap: 1ch;
  }

  .nf-row dt {
    color: var(--accent);
    font-weight: 700;
    min-width: 9ch;
  }

  .nf-row dd {
    margin: 0;
    color: var(--ink);
  }

  .term-hint {
    margin: 0;
  }

  /* ---------- prompt + block cursor ---------- */

  .term-form {
    display: flex;
    align-items: baseline;
    gap: 1ch;
    margin-top: var(--sp-1);
  }

  .term-field {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .term-input {
    width: 100%;
    font: inherit;
    color: var(--ink);
    background: transparent;
    border: 0;
    padding: 0;
    caret-color: transparent; /* replaced by the block below */
  }

  .term-input:focus {
    outline: none;
  }

  .term-cursor {
    position: absolute;
    top: 0;
    left: 0;
    width: 1ch;
    color: var(--bg);
    background: var(--accent);
    white-space: pre;
    pointer-events: none;
    animation: blink 1.05s step-end infinite;
  }

  .term-form:not(:focus-within) .term-cursor {
    background: transparent;
    color: transparent;
    box-shadow: inset 0 0 0 1px var(--dim);
    animation: none;
  }

  @media (max-width: 640px) {
    .term-title,
    .term-hint-scroll {
      display: none;
    }

    /* Keep the art on phones — it just stacks above the info instead of sitting
       beside it. At ~24 columns the salmon still fits a 390px screen. */
    .neofetch {
      flex-direction: column;
      align-items: center;
      gap: var(--sp-4);
    }

    .nf-info {
      align-self: stretch;
    }
  }
</style>

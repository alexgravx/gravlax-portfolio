---
import SectionHead from './SectionHead.astro';
import { profile, education, skills, experience, projects, clubs, resumePdf } from '../content/resume';

interface Props {
  /** Style section headers as shell commands (`$ cat about.txt`) vs plain `-- ABOUT --` rules. */
  style: 'shell' | 'plain';
}

const { style } = Astro.props;

const sections = [
  { id: 'about', cmd: 'whoami' },
  { id: 'experience', cmd: 'cat experience.md' },
  { id: 'projects', cmd: 'ls -l projects/' },
  { id: 'skills', cmd: 'cat skills.txt' },
  { id: 'education', cmd: 'cat education.md' },
  { id: 'clubs', cmd: 'cat clubs.md' },
  { id: 'contact', cmd: 'contact' },
];

const head = (id: string) => sections.find((s) => s.id === id)!;
---

<div class="sections">
  {/* ---------------- about ---------------- */}
  <section id="about" class="section">
    <SectionHead style={style} id="about" cmd={head('about').cmd} />
    <p>{profile.bio}</p>
  </section>

  {/* ---------------- experience ---------------- */}
  <section id="experience" class="section">
    <SectionHead style={style} id="experience" cmd={head('experience').cmd} />
    {experience.map((r) => (
      <div class="entry">
        <div class="entry-head">
          <strong>{r.href ? <a href={r.href} target="_blank" rel="noopener noreferrer">{r.org}</a> : r.org}</strong>
          <span class="comment">{r.start} — {r.end}</span>
        </div>
        <div>
          {r.title} <span class="comment">· {r.location}</span>
        </div>
        <ul class="bullets">
          {r.bullets.map((b) => (
            <li>
              {b.text}
              {b.children && (
                <ul class="bullets">
                  {b.children.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
        <ul class="tags">
          {r.stack.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  {/* ---------------- projects ---------------- */}
  <section id="projects" class="section">
    <SectionHead style={style} id="projects" cmd={head('projects').cmd} />
    {projects.map((p) => (
      <div class="entry">
        <div class="entry-head">
          <strong>{p.name}</strong>
          {p.href && p.hrefLabel && (
            <a href={p.href} target="_blank" rel="noopener noreferrer">
              {p.hrefLabel}
            </a>
          )}
        </div>
        <div>{p.blurb}</div>
        <ul class="tags">
          {p.stack.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  {/* ---------------- skills ---------------- */}
  <section id="skills" class="section">
    <SectionHead style={style} id="skills" cmd={head('skills').cmd} />
    {Object.entries(skills).map(([group, items]) => (
      <div class="entry skill-row">
        <strong class="skill-group">{group}</strong>
        <ul class="tags">
          {items.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  {/* ---------------- education ---------------- */}
  <section id="education" class="section">
    <SectionHead style={style} id="education" cmd={head('education').cmd} />
    {education.map((e) => (
      <div class="entry">
        <div class="entry-head">
          <strong>{e.detail}</strong>
          <span class="comment">{e.date}</span>
        </div>
        <div>
          {e.degree}
          {e.note && <span class="comment"> ({e.note})</span>}
        </div>
        {e.coursework && <div class="comment"># {e.coursework.join(', ')}</div>}
      </div>
    ))}
  </section>

  {/* ---------------- clubs ---------------- */}
  <section id="clubs" class="section">
    <SectionHead style={style} id="clubs" cmd={head('clubs').cmd} />
    {clubs.map((r) => (
      <div class="entry">
        <div class="entry-head">
          <strong>{r.href ? <a href={r.href} target="_blank" rel="noopener noreferrer">{r.org}</a> : r.org}</strong>
          <span class="comment">{r.start} — {r.end}</span>
        </div>
        <div>
          {r.title} <span class="comment">· {r.location}</span>
        </div>
        <ul class="bullets">
          {r.bullets.map((b) => (
            <li>{b.text}</li>
          ))}
        </ul>
        <ul class="tags">
          {r.stack.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  {/* ---------------- contact ---------------- */}
  <section id="contact" class="section">
    <SectionHead style={style} id="contact" cmd={head('contact').cmd} />
    <div class="entry">
      {profile.links.map((l) => (
        <div>
          <span class="comment">{l.label.padEnd(9)}</span>
          <a href={l.href} target="_blank" rel="noopener noreferrer">
            {l.href}
          </a>
        </div>
      ))}
      <div>
        <span class="comment">{'resume'.padEnd(9)}</span>
        <a href="/resume">/resume</a> · <a href={resumePdf}>download .pdf</a>
      </div>
    </div>
  </section>
</div>

<style>
  .sections {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .section {
    scroll-margin-top: 96px;
  }

  .skill-row {
    display: flex;
    gap: var(--sp-3);
    align-items: baseline;
    flex-wrap: wrap;
    margin-bottom: var(--sp-3);
  }

  .skill-group {
    min-width: 11ch;
  }

  .skill-row .tags {
    margin-top: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

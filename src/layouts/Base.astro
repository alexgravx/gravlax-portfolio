---
import '../styles/theme.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile } from '../content/resume';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.title}`,
  description = profile.bio.slice(0, 155),
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Set the theme before first paint, so there is never a flash of the wrong one. */}
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = saved ?? (prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <div class="screen-mesh"></div>

    <header class="topbar">
      <a class="brand" href="/">{profile.handle}<span class="blink">_</span></a>
      <nav class="topnav">
        <a href="/#projects">projects</a>
        <a href="/#experience">experience</a>
        <a href="/resume">resume</a>
        <ThemeToggle />
      </nav>
    </header>

    <slot />

    <footer class="foot">
      <span class="comment"># {profile.name} — built with Astro. No trackers, no cookies.</span>
      <span class="links">
        {
          profile.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer">
              {l.label}
            </a>
          ))
        }
      </span>
    </footer>

    <style>
      .topbar {
        position: sticky;
        top: 0;
        z-index: 400;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-4);
        padding: var(--sp-3) var(--sp-4);
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
      }

      .brand {
        color: var(--ink);
        font-weight: 700;
        border: 0;
      }

      .brand:hover {
        color: var(--accent);
      }

      .topnav {
        display: flex;
        align-items: center;
        gap: var(--sp-4);
        font-size: var(--step--1);
      }

      .foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--sp-3);
        max-width: 84ch;
        margin: 0 auto;
        padding: var(--sp-5) var(--sp-4) var(--sp-7);
        border-top: 1px dashed var(--border);
        font-size: var(--step--1);
      }

      .foot .links {
        display: flex;
        gap: var(--sp-4);
      }

      @media (max-width: 560px) {
        .topnav {
          gap: var(--sp-3);
        }
      }
    </style>
  </body>
</html>

---
import '../styles/theme.css';
import StatusBar from '../components/StatusBar.astro';
import Loader from '../components/Loader.astro';
import { profile } from '../content/resume';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.title}`,
  description = profile.bio.slice(0, 155),
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Set the theme before first paint, so there is never a flash of the wrong one. */}
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = saved ?? (prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <Loader />
    <div class="screen-mesh"></div>

    <slot />

    <StatusBar />

    <script>
      import { initScramble, initCursor } from '../scripts/effects';
      initScramble();
      initCursor();
    </script>
  </body>
</html>

<style is:global>
  /* Keep content clear of the fixed tmux status line. */
  body {
    padding-bottom: 32px;
  }
</style>
